{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/app",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    "jsx": "react-jsx",
    "lib": ["dom"],
    "types": ["node", "@nx/react/typings/cssmodule.d.ts", "@nx/react/typings/image.d.ts", "vite/client"],
    "rootDir": "src",
    "module": "esnext",
    "moduleResolution": "bundler"
  },
  "exclude": [
    "out-tsc",
    "dist",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "src/**/*.spec.tsx",
    "src/**/*.test.tsx",
    "src/**/*.spec.js",
    "src/**/*.test.js",
    "src/**/*.spec.jsx",
    "src/**/*.test.jsx",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs",
    "src/test-setup.ts"
  ],
  "include": ["src/**/*.js", "src/**/*.jsx", "src/**/*.ts", "src/**/*.tsx"],
  "references": [
    {
      "path": "../../libs/web/ui-whiteboard/tsconfig.lib.json"
    },
    {
      "path": "../../libs/web/ui-primitives/tsconfig.lib.json"
    },
    {
      "path": "../../libs/web/feature-template-editor/tsconfig.lib.json"
    },
    {
      "path": "../../libs/web/feature-session-room/tsconfig.lib.json"
    },
    {
      "path": "../../libs/web/feature-dashboard/tsconfig.lib.json"
    },
    {
      "path": "../../libs/web/data-access-api/tsconfig.lib.json"
    }
  ]
}
