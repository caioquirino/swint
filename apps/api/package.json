{
  "name": "api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/esbuild:esbuild",
        "outputs": [
          "{options.outputPath}"
        ],
        "defaultConfiguration": "production",
        "options": {
          "platform": "node",
          "outputPath": "apps/api/dist",
          "format": [
            "esm"
          ],
          "bundle": false,
          "main": "apps/api/src/main.ts",
          "tsConfig": "apps/api/tsconfig.app.json",
          "assets": [
            "apps/api/src/assets"
          ],
          "esbuildOptions": {
            "sourcemap": true,
            "outExtension": {
              ".js": ".js"
            }
          }
        },
        "configurations": {
          "development": {},
          "production": {
            "esbuildOptions": {
              "sourcemap": false,
              "outExtension": {
                ".js": ".js"
              }
            }
          }
        }
      },
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api/dist/package.json",
          "{workspaceRoot}/apps/api/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api/dist/patches",
          "{workspaceRoot}/apps/api/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "nx:run-commands",
        "options": {
          "command": "tsx watch --conditions=swint --clear-screen=false apps/api/src/main.ts"
        }
      },
      "serve-dist": {
        "continuous": true,
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "options": {
          "command": "node apps/api/dist/main.js"
        }
      }
    },
    "tags": [
      "scope:api"
    ]
  },
  "dependencies": {
    "@swint/api-util-rpc": "workspace:*",
    "@swint/api-data-access-persistence": "workspace:*",
    "@swint/api-feature-auth": "workspace:*",
    "@swint/api-feature-templates": "workspace:*",
    "@swint/api-feature-sessions": "workspace:*",
    "@swint/shared-api-contract": "workspace:*",
    "fastify": "^5.12.8",
    "@fastify/cookie": "^11.1.5",
    "@orpc/server": "^1.16.2",
    "@orpc/openapi": "^1.16.2",
    "@orpc/zod": "^1.16.2",
    "zod": "^4.6.7",
    "pino": "^10.4.0",
    "@swint/api-collab-server": "workspace:*"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^4.8.0",
    "@orpc/client": "^1.16.2",
    "@orpc/contract": "^1.16.2",
    "@orpc/openapi-client": "^1.16.2",
    "@swint/shared-collab-protocol": "workspace:*",
    "ws": "^8.22.1",
    "yjs": "^13.6.0"
  }
}
