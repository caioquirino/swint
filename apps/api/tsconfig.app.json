{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/app",
    "types": [
      "node"
    ],
    "rootDir": "src",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts"
  ],
  "exclude": [
    "out-tsc",
    "dist",
    "vite.config.ts",
    "vite.config.mts",
    "vitest.config.ts",
    "vitest.config.mts",
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.tsx",
    "src/**/*.test.js",
    "src/**/*.spec.js",
    "src/**/*.test.jsx",
    "src/**/*.spec.jsx",
    "src/test-env.d.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/shared/api-contract/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/feature-sessions/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/feature-templates/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/feature-auth/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/data-access-persistence/tsconfig.lib.json"
    },
    {
      "path": "../../libs/api/util-rpc/tsconfig.lib.json"
    }
  ]
}
